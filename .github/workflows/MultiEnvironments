name: Multi-Environment Deployment

on:
  workflow_dispatch:
    inputs:
      environments:
        description: 'Comma-separated list of environments (e.g., dev,npe,prod)'
        required: true
        default: 'dev'

jobs:
  build:
    runs-on: ubuntu-latest
    outputs:
      matrix: ${{ steps.set-matrix.outputs.matrix }}
    steps:
      - name: Convert input to JSON array
        id: set-matrix
        run: |
          INPUTS="${{ github.event.inputs.environments }}"
          ENV_LIST=$(echo "$INPUTS" | awk -F',' '{for(i=1;i<=NF;i++) printf "\"%s\"%s", $i, (i<NF?",":"") }')
          echo "::set-output name=matrix::{\"env\":[$ENV_LIST]}"
        shell: bash

  deploy:
    needs: build
    runs-on: ubuntu-latest
    strategy:
      matrix: ${{ fromJson(needs.build.outputs.matrix) }}
    name: Deploy to ${{ matrix.env }}
    steps:
      - name: Set variable1 based on environment position
        id: set_variable
        run: |
          # hardcode same order as input if needed
          INPUTS="${{ github.event.inputs.environments }}"
          INDEX=$(echo "$INPUTS" | tr ',' '\n' | awk "/${{ matrix.env }}/ {print NR}")
          if [[ $INDEX -eq 1 ]]; then
            echo "variable1=false"
            echo "::set-output name=flag::false"
          else
            echo "variable1=true"
            echo "::set-output name=flag::true"
          fi
        shell: bash

      - name: Deploy logic using variable1
        run: echo "Deploying to ${{ matrix.env }} with variable1=${{ steps.set_variable.outputs.flag }}"
